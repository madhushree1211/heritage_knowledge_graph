    {
      "type": "ArchitecturalStyle",
      "properties": {
        "id": "dravidian_architecture",
        "name": "Dravidian Architecture",
        "description": "An architectural style in the Hindu temple architecture that emerged in the southern part of the Indian subcontinent. It consists primarily of temples with pyramid-shaped towers (Vimana), pillared halls (Mandapa), and monumental gateway towers (Gopuram).",
        "source": "Encyclopaedia of Indian Temple Architecture"
      }
    },
    {
      "type": "ArchitecturalFeature",
      "properties": {
        "id": "vimana",
        "name": "Vimana",
        "description": "The tower built over the garbhagriha (inner sanctum) of a Hindu temple in Dravidian architecture. It is typically pyramid-shaped, rising in tiers (talas). The Vimana of the Brihadisvara Temple is legendary for its monumental size and scale, reaching 66 meters in height.",
        "source": "Glossary of Indian Temple Architecture"
      }
    },
    {
      "type": "ArchitecturalFeature",
      "properties": {
        "id": "gopuram",
        "name": "Gopuram",
        "description": "A monumental entrance tower, usually ornate, at the entrance of a Hindu temple, particularly in Dravidian style. The Meenakshi Amman Temple and Ranganathaswamy Temple are famous for their giant multi-tiered gopurams.",
        "source": "Glossary of Indian Temple Architecture"
      }
    },
    {
      "type": "ArchitecturalFeature",
      "properties": {
        "id": "mandapa",
        "name": "Mandapa",
        "description": "A pillared outdoor hall or pavilion for public rituals in Hindu temples. In Chola architecture, mandapas (like the chariot-shaped one in Darasuram) evolved into sophisticated structures with pillars featuring delicate relief carvings.",
        "source": "Glossary of Indian Temple Architecture"
      }
    },
    {
      "type": "ArchitecturalFeature",
      "properties": {
        "id": "monolithic_ratha",
        "name": "Monolithic Ratha",
        "description": "A rock-cut structure shaped like a chariot, carved out of a single granite boulder, characteristic of early Pallava architecture in Mamallapuram (e.g. Pancha Rathas).",
        "source": "Glossary of Indian Temple Architecture"
      }
    },
    {
      "type": "Deity",
      "properties": {
        "id": "shiva",
        "name": "Shiva",
        "description": "One of the principal deities of Hinduism, worshipped as the supreme destroyer and transformer. Most major Chola and Pallava temples are dedicated to Shiva.",
        "source": "Hindu Iconography"
      }
    },
    {
      "type": "Deity",
      "properties": {
        "id": "vishnu",
        "name": "Vishnu",
        "description": "The preserver deity of Hinduism. Major temples like Srirangam and sections of the Shore Temple are dedicated to Vishnu in various forms.",
        "source": "Hindu Iconography"
      }
    },
    {
      "type": "Inscription",
      "properties": {
        "id": "thanjavur_inscriptions",
        "name": "Thanjavur Inscriptions",
        "language": "Tamil and Sanskrit",
        "script": "Tamil and Grantha",
        "date": "1010 CE",
        "description": "Carved onto the stone base of the Brihadisvara Temple, these inscriptions list the extensive donations of gold, land, and jewelry by Rajaraja Chola I, his sister Kundavai, and his queens, providing detailed insights into Chola economy, temple dancers, and administration.",
        "source": "South Indian Inscriptions, Vol II"
      }
    },
    {
      "type": "Inscription",
      "properties": {
        "id": "uttiramerur_inscriptions",
        "name": "Uttiramerur Inscriptions",
        "language": "Tamil",
        "script": "Tamil",
        "date": "920 CE",
        "description": "Located on the walls of the Vaikuntha Perumal temple in Uttiramerur, these inscriptions detail a highly functional system of local self-governance, committee elections (Kudavolai system), and qualification standards for Chola village assemblies.",
        "source": "Epigraphia Indica, Vol XXII"
      }
    },
    {
      "type": "HistoricalEvent",
      "properties": {
        "id": "coronation_rajaraja",
        "name": "Coronation of Rajaraja Chola I",
        "date": "985 CE",
        "description": "Marks the ascension of Arulmozhi Varman as Rajaraja Chola I, triggering the golden period of expansion and construction in South India.",
        "source": "Chola Royal Genealogy Studies"
      }
    },
    {
      "type": "HistoricalEvent",
      "properties": {
        "id": "conquest_kadaram",
        "name": "Conquest of Kadaram (Sumatra)",
        "date": "1025 CE",
        "description": "A major naval campaign launched by Rajendra Chola I against the Srivijaya empire in Southeast Asia, ensuring free maritime trade routes for Tamil merchant guilds.",
        "source": "Larger Leyden Grant Inscription"
      }
    }
  ],
